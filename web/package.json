{
  "name": "molisync-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build-docs.mjs && tailwindcss -i ./src/tailwind.css -o ./assets/css/site.css --minify && node scripts/stage-pages.mjs",
    "docs": "node scripts/build-docs.mjs",
    "stage": "node scripts/stage-pages.mjs",
    "dev": "tailwindcss -i ./src/tailwind.css -o ./assets/css/site.css --watch"
