<?xml version="1.0" encoding="utf-8"?>
<!--
  The app stores only the server URL, certificate alias and fingerprint.
  Backup is disabled in the manifest; these rules additionally prevent the
  KeyChain alias from being copied through cloud backup or device-to-device
  transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
