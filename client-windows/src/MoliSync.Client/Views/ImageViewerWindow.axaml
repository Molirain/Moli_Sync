<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MoliSync.Client.Views.ImageViewerWindow"
        Width="920" Height="700" MinWidth="520" MinHeight="420"
        Title="图片预览"
        Background="#1C2A24">
  <Grid RowDefinitions="Auto,*">
    <Border Background="#14211C" Padding="16,10">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="TitleText" Foreground="#E7F2EC" FontSize="13" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Classes="small" Click="OpenExternal_OnClick">用默认应用打开</Button>
          <Button Classes="small" Click="SaveAs_OnClick">另存为…</Button>
          <Button Classes="small" Click="Close_OnClick">关闭</Button>
        </StackPanel>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <Image x:Name="PreviewImage" Stretch="Uniform" Margin="12" />
    </ScrollViewer>
  </Grid>
</Window>
