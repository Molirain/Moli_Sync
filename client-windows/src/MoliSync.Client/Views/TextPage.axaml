<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="using:MoliSync.Client.Services"
             x:Class="MoliSync.Client.Views.TextPage"
             x:DataType="svc:ShellViewModel">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Background="{StaticResource HeaderBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
            Padding="28,22,28,16">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="文字" Classes="h1" />
          <TextBlock Text="轻量文字与剪贴板，全量保存在服务器，所有设备可见" Classes="muted" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="icon" Click="Refresh_OnClick" ToolTip.Tip="刷新">
            <PathIcon Data="M12,2 A10,10 0 1 0 22,12 H19 A7,7 0 1 1 12,5 Z M13,1 L17,5 L13,9 Z" Width="14" Height="14" />
          </Button>
          <Button Classes="primary" Click="Compose_OnClick">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="M11,5 H13 V11 H19 V13 H13 V19 H11 V13 H5 V11 H11 Z" Width="14" Height="14" Foreground="#F6F2E6" />
              <TextBlock Text="发送文字" Foreground="#F6F2E6" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="28,14,28,24" Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding StatusText}" Classes="caption" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="文字永久保存在服务器" Classes="caption" />
        </Grid>

        <ItemsControl ItemsSource="{Binding TextRecords}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="svc:RecordItem">
              <Border Classes="card" Margin="0,0,0,9">
                <StackPanel Spacing="7">
                  <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                    <Border Width="22" Height="22" CornerRadius="7" Background="{StaticResource SoftGreenBrush}">
                      <TextBlock Text="{Binding Initial}" FontSize="9" FontWeight="Bold"
                                 Foreground="#1D5346" VerticalAlignment="Center"
                                 HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="20" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Subtitle}" Classes="caption" Margin="7,0,0,0"
                               VerticalAlignment="Center" />
                    <Border Grid.Column="3" Classes="badge">
                      <TextBlock Text="云端" FontSize="9.5" FontWeight="SemiBold" Foreground="#276B53" />
                    </Border>
                  </Grid>
                  <TextBlock Text="{Binding Text}" FontSize="13.5" TextWrapping="Wrap" MaxHeight="140"
                             Foreground="#26332C" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding TextMeta}" Classes="caption" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                      <Button Classes="icon" Click="Copy_OnClick" ToolTip.Tip="复制">
                        <PathIcon Data="M9,2 H18 A2,2 0 0 1 20,4 V16 H18 V4 H9 Z M5,6 H14 A2,2 0 0 1 16,8 V20 A2,2 0 0 1 14,22 H5 A2,2 0 0 1 3,20 V8 A2,2 0 0 1 5,6 Z" Width="13" Height="13" />
                      </Button>
                      <Button Classes="icon" Click="Delete_OnClick" IsVisible="{Binding IsMine}" ToolTip.Tip="删除">
                        <PathIcon Data="M8,3 H16 L17,5 H21 V7 H3 V5 H7 Z M5,8 H19 L18,21 H6 Z" Width="13" Height="13" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
