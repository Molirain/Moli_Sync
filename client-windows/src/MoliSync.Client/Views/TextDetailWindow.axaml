<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MoliSync.Client.Views.TextDetailWindow"
        Width="640" Height="480"
        MinWidth="420" MinHeight="260"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Title="文字详情"
        Background="{StaticResource PaperBrush}">
  <Grid RowDefinitions="Auto,*,Auto" Margin="22">
    <StackPanel Spacing="4">
      <TextBlock Text="文字详情" Classes="h2" />
      <TextBlock x:Name="MetaText" Classes="caption" />
    </StackPanel>

    <Border Grid.Row="1" Margin="0,14" Background="{StaticResource HeaderBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
      <ScrollViewer>
        <SelectableTextBlock x:Name="BodyText" TextWrapping="Wrap" FontSize="13.5"
                             Foreground="#26332C" />
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Click="CopyAll_OnClick">复制全文</Button>
      <Button Classes="primary" Click="Close_OnClick">关闭</Button>
    </StackPanel>
  </Grid>
</Window>
