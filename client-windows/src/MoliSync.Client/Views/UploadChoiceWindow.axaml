<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MoliSync.Client.Views.UploadChoiceWindow"
        Width="500" Height="300"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PaperBrush}">
  <Grid RowDefinitions="*,Auto" Margin="22">
    <StackPanel Spacing="8">
      <TextBlock Text="选择发送方式" Classes="h2" />
      <TextBlock x:Name="SummaryText" Classes="muted" TextWrapping="Wrap" />
      <Border Background="#F3EEE2" BorderBrush="#E6DECE" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,6,0,0">
        <TextBlock x:Name="HintText" Classes="caption" TextWrapping="Wrap" />
      </Border>
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Click="Cancel_OnClick">取消</Button>
      <Button x:Name="P2PButton" Click="P2P_OnClick">P2P 直连</Button>
      <Button x:Name="CloudButton" Classes="primary" Click="Cloud_OnClick">保存到服务器</Button>
    </StackPanel>
  </Grid>
</Window>
