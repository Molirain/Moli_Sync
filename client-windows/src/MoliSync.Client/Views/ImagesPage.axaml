<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="using:MoliSync.Client.Services"
             x:Class="MoliSync.Client.Views.ImagesPage"
             x:DataType="svc:ShellViewModel">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Background="{StaticResource HeaderBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
            Padding="28,22,28,16">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="图片" Classes="h1" />
          <TextBlock Text="不超过阈值的图片可保存到服务器，超过阈值仅走 P2P" Classes="muted" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Click="OpenFolder_OnClick">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="M3,6 A2,2 0 0 1 5,4 H9 L11,6 H19 A2,2 0 0 1 21,8 V18 A2,2 0 0 1 19,20 H5 A2,2 0 0 1 3,18 Z" Width="14" Height="14" />
              <TextBlock Text="打开数据目录" />
            </StackPanel>
          </Button>
          <Button Classes="primary" Click="Upload_OnClick">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="M11,5 H13 V11 H19 V13 H13 V19 H11 V13 H5 V11 H11 Z" Width="14" Height="14" Foreground="#F6F2E6" />
              <TextBlock Text="上传图片" Foreground="#F6F2E6" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="28,16,28,24" Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding StatusText}" Classes="caption" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding Settings.CloudThresholdBytes, StringFormat='云端阈值 {0} 字节'}" Classes="caption" />
        </Grid>

        <ItemsControl ItemsSource="{Binding ImageRecords}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="svc:RecordItem">
              <Border Width="228" Height="212" Margin="0,0,12,12" CornerRadius="15"
                      Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
                      BorderThickness="1" ClipToBounds="True">
                <Grid RowDefinitions="132,*">
                  <Grid Grid.Row="0" Background="{Binding AccentBrush}">
                    <Border Background="#E6FFFCF6" CornerRadius="7" Padding="7,3"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9">
                      <TextBlock Text="云端" FontSize="9.5" FontWeight="SemiBold" Foreground="#276B53" />
                    </Border>
                    <TextBlock Text="{Binding FileName}" Foreground="#F7F3E8" FontSize="11"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Bottom" Margin="10" />
                  </Grid>
                  <Grid Grid.Row="1" RowDefinitions="Auto,Auto" Margin="11,8,11,8">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="1">
                        <TextBlock Text="{Binding SizeAndSender}" FontSize="10.5" Foreground="#5B6A62"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding TimeText}" Classes="caption" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="small" Click="Download_OnClick"
                              Content="{Binding DownloadLabel}" />
                    </Grid>
                    <StackPanel Grid.Row="1" Spacing="3" IsVisible="{Binding IsDownloading}">
                      <ProgressBar Value="{Binding DownloadPercent}" Maximum="100" />
                      <TextBlock Text="{Binding DownloadPercent, StringFormat='下载中 {0:F0}%'}" Classes="caption" />
                    </StackPanel>
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
